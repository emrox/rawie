<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RAWimp.App</RootNamespace>
    <AssemblyName>RAWimp</AssemblyName>

    <!-- Shown in the built exe's Properties → Details, and by the installer. -->
    <Product>RAWimp</Product>
    <Company>Stefan Bauckmeier</Company>
    <Authors>Stefan Bauckmeier</Authors>
    <!-- Plain ASCII: the version-resource encoding mangles (c) and dashes into mojibake. -->
    <Copyright>Copyright (C) 2026 Stefan Bauckmeier. GNU GPL v3.0.</Copyright>
    <Description>A fast photo browser, culler and image importer for Windows.</Description>
    <!-- FileDescription (what Task Manager and the Properties dialog show) comes from AssemblyTitle,
         not Description. -->
    <AssemblyTitle>RAWimp — photo browser, culler and importer</AssemblyTitle>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Required even though the app is unpackaged: this switches on the tooling that compiles XAML
         into .xbf and builds the resources.pri index. Without it a *published* build silently ships
         no XAML at all and dies with "Cannot locate resource from 'ms-appx:///MainWindow.xaml'". -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ship one language rather than ~40 sets of satellite resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The Windows App SDK bundles ONNX Runtime and DirectML (~39 MB) for its Windows AI APIs.
       RAWimp uses none of them, and a self-contained build runs fine without them — verified by
       publishing, deleting them and launching. Delete this target if the app ever adopts a
       Windows AI feature. -->
  <Target Name="DropUnusedAiRuntimes" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_UnusedAiRuntime Include="$(PublishDir)onnxruntime.dll" />
      <_UnusedAiRuntime Include="$(PublishDir)DirectML.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedAiRuntime)" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <!-- Also needed at runtime: the window icon is set from this file (see MainWindow.StyleTitleBar). -->
    <Content Include="..\..\assets\logo.ico" Link="logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shown in the About dialog, so it has to ship rather than only being the exe's icon. -->
    <Content Include="..\..\assets\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Vanara.Windows.Shell" Version="5.0.5" />
  </ItemGroup>

</Project>
