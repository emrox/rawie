<Window
    x:Class="RAWimp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RAWimp.App">

    <!-- KeyboardAcceleratorPlacementMode=Hidden: the root Grid spans the window, so WinUI's automatic
         "Ctrl+O" accelerator tooltip would pop up whenever the pointer sits over empty space. -->
    <Grid x:Name="Root" ColumnDefinitions="260,6,*,Auto" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenExternalAccel" />
        </Grid.KeyboardAccelerators>

        <!-- folder tree (lazy-loaded) -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <!-- TreeView's own scroll viewer won't scroll sideways, so it sits in one that will.
                 The tree is left-aligned and its internal scrolling switched off, letting deep
                 folder names extend past the pane and become reachable. -->
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="FolderTree" Padding="4" ItemsSource="{x:Bind Roots}"
                      SelectionMode="Single"
                      HorizontalAlignment="Left"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      Expanding="OnFolderExpanding" ItemInvoked="OnFolderInvoked"
                      RightTapped="OnTreeRightTapped">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderNode">
                        <TreeViewItem ItemsSource="{x:Bind Children}" Content="{x:Bind Name}"
                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                      IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                                      AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop"
                                      AutomationProperties.Name="{x:Bind Name}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </ScrollViewer>
        </Border>

        <!-- drag to resize the folder pane -->
        <local:SplitterBar Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                           PointerPressed="OnSplitterPressed"
                           PointerMoved="OnSplitterMoved"
                           PointerReleased="OnSplitterReleased" />

        <!-- content: toolbar + (grid | preview) + status -->
        <Grid x:Name="CenterPane" Grid.Column="2" RowDefinitions="Auto,*,Auto" SizeChanged="OnCenterPaneSizeChanged">
            <!-- A Grid rather than a StackPanel so the folder path takes the slack and About can sit
                 hard right. It also gives PathText a bounded width, so its ellipsis actually works. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Padding="12">
                <!-- Shown only when the toolbar no longer fits; holds the same commands. -->
                <Button x:Name="MenuButton" Grid.Column="0" Visibility="Collapsed" Padding="10,5"
                        AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu">
                    <local:LucideIcon Glyph="menu" Size="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <!-- FontIcon, not the path-drawn LucideIcon: MenuFlyoutItem.Icon accepts
                                 only an IconElement, which has no public constructor and so cannot be
                                 subclassed. Same artwork, taken from Lucide's own icon font; the
                                 glyph codes come from its info.json. -->
                            <MenuFlyoutItem Text="Open folder" Click="OnPickFolder">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE247;" FontSize="16" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Import" Click="OnOpenImport">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE22F;" FontSize="16" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Settings" Click="OnOpenSettings">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE154;" FontSize="16" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="About" Click="OnOpenAbout">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE0F9;" FontSize="16" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="FilterMenu" Text="Filter">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE0DC;" FontSize="16" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="SortMenu" Text="Sort">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource LucideFont}" Glyph="&#xE37D;" FontSize="16" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <StackPanel x:Name="WideTools" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Click="OnPickFolder">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <local:LucideIcon Glyph="folder-open" Size="16" />
                        <TextBlock Text="Open folder" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenImport">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <local:LucideIcon Glyph="import" Size="16" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenSettings">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <local:LucideIcon Glyph="settings" Size="16" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>

                <!-- ItemsSource + DataTemplate rather than inline ComboBoxItems holding panels: a
                     UIElement can have only one parent, so the collapsed box would steal the visual
                     from the drop-down row and the selected entry would render blank. A template is
                     realised separately for each. -->
                <ComboBox x:Name="FilterBox" MinWidth="150" SelectionChanged="OnViewOptionChanged"
                          ItemsSource="{x:Bind FilterOptions}" SelectedIndex="0"
                          ToolTipService.ToolTip="Show only photos with this rating">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ViewOption">
                            <StackPanel Orientation="Horizontal" Spacing="7"
                                        AutomationProperties.Name="{x:Bind Label}">
                                <local:LucideIcon Glyph="{x:Bind Glyph}" Size="13" Filled="{x:Bind Filled}" />
                                <TextBlock Text="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="SortBox" MinWidth="130" SelectionChanged="OnViewOptionChanged"
                          ItemsSource="{x:Bind SortOptions}" SelectedIndex="0"
                          ToolTipService.ToolTip="Sort order">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ViewOption">
                            <StackPanel Orientation="Horizontal" Spacing="7"
                                        AutomationProperties.Name="{x:Bind Label}">
                                <local:LucideIcon Glyph="{x:Bind Glyph}" Size="13" Filled="{x:Bind Filled}" />
                                <TextBlock Text="{x:Bind Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                </StackPanel>

                <TextBlock x:Name="PathText" Grid.Column="2" Text="(no folder)" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Icon-only and out on its own: About is rarely reached for, so it stays clear of
                     the commands. Hidden when the burger takes over, which carries it as an item. -->
                <Button x:Name="AboutButton" Grid.Column="3" Click="OnOpenAbout" Padding="10,5"
                        AutomationProperties.Name="About" ToolTipService.ToolTip="About RAWimp">
                    <local:LucideIcon Glyph="info" Size="16" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <GridView x:Name="ThumbGrid" Padding="8"
                          SelectionMode="Extended"
                          UseSystemFocusVisuals="False"
                          CanDragItems="True"
                          DragItemsStarting="OnGridDragItemsStarting"
                          AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop"
                          SelectionChanged="OnSelectionChanged"
                          DoubleTapped="OnItemDoubleTapped"
                          RightTapped="OnItemRightTapped"
                          ContainerContentChanging="OnContainerContentChanging">
                    <!-- The focus ring is drawn by the item container, so it has to be switched off
                         here rather than on the GridView. Selection follows focus, so the blue
                         selection border already shows where you are. -->
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
                            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:PhotoItem">
                            <Grid Width="184" Height="184" Margin="4" RowDefinitions="*,Auto"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{x:Bind SelectionBrush, Mode=OneWay}" BorderThickness="2"
                                  CornerRadius="4"
                                  AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop">
                                <Image Grid.Row="0" Source="{x:Bind Thumb, Mode=OneWay}" Stretch="Uniform" Margin="4" />
                                <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Visibility="{x:Bind RatingVisibility, Mode=OneWay}"
                                        Background="#A0000000" CornerRadius="3" Padding="5,1" Margin="0,0,0,3">
                                    <ItemsControl ItemsSource="{x:Bind RatingPips, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:RatingPip">
                                                <local:LucideIcon Glyph="{x:Bind Glyph}" Size="13"
                                                                  Filled="{x:Bind Filled}" Tint="{x:Bind Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Padding="4,2" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- rubber-band selection box; drawn over the grid, never hit-testable -->
                <Rectangle x:Name="Marquee" Visibility="Collapsed" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25"
                           Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" />

                <!-- preview mode overlay (Enter / double-click); Esc or ← → to navigate -->
                <Grid x:Name="PreviewPanel" Visibility="Collapsed" IsTabStop="True"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top"
                                HorizontalAlignment="Right" Margin="16">
                        <TextBlock x:Name="PreviewHint" Text="Esc: back    ← →: navigate    1-5: rate    X: reject"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                        <!-- Esc already closes; this is the same exit for anyone reaching for the mouse. -->
                        <Button Click="OnClosePreview" ToolTipService.ToolTip="Close preview (Esc)"
                                Background="Transparent" BorderThickness="0" Padding="7,3" FontSize="14">
                            <local:LucideIcon Glyph="x" Size="15" />
                        </Button>
                    </StackPanel>
                    <Border x:Name="PreviewRatingBox" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,18" Visibility="Collapsed"
                            Background="#A0000000" CornerRadius="4" Padding="10,3">
                        <ItemsControl x:Name="PreviewRating">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RatingPip">
                                    <local:LucideIcon Glyph="{x:Bind Glyph}" Size="19"
                                                      Filled="{x:Bind Filled}" Tint="{x:Bind Brush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl></Border>
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Padding="12,6" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- info / EXIF panel -->
        <Border Grid.Column="3" Width="300" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer>
                <StackPanel Padding="14" Spacing="6">
                    <TextBlock Text="Rating" FontWeight="SemiBold" />
                    <!-- Each star sits in a Border so the whole cell is tappable, not just the glyph
                         (LucideIcon is hit-test invisible so it can't swallow the click). The
                         Transparent background is load-bearing: with no brush at all a Border is not
                         hit-testable, and the taps went nowhere. -->
                    <StackPanel x:Name="RatingStars" Orientation="Horizontal" Spacing="2" Margin="0,0,0,10">
                        <Border Tag="1" Padding="2" Background="Transparent"
                                Tapped="OnStarTapped" ToolTipService.ToolTip="1 star">
                            <local:LucideIcon Glyph="star" Size="22" />
                        </Border>
                        <Border Tag="2" Padding="2" Background="Transparent"
                                Tapped="OnStarTapped" ToolTipService.ToolTip="2 stars">
                            <local:LucideIcon Glyph="star" Size="22" />
                        </Border>
                        <Border Tag="3" Padding="2" Background="Transparent"
                                Tapped="OnStarTapped" ToolTipService.ToolTip="3 stars">
                            <local:LucideIcon Glyph="star" Size="22" />
                        </Border>
                        <Border Tag="4" Padding="2" Background="Transparent"
                                Tapped="OnStarTapped" ToolTipService.ToolTip="4 stars">
                            <local:LucideIcon Glyph="star" Size="22" />
                        </Border>
                        <Border Tag="5" Padding="2" Background="Transparent"
                                Tapped="OnStarTapped" ToolTipService.ToolTip="5 stars">
                            <local:LucideIcon Glyph="star" Size="22" />
                        </Border>
                        <Border x:Name="RejectMark" Padding="2" Margin="12,0,0,0" Background="Transparent"
                                Tapped="OnRejectTapped" ToolTipService.ToolTip="Reject (X)">
                            <local:LucideIcon x:Name="RejectIcon" Glyph="ban" Size="20" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Info" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl x:Name="ExifList" ItemsSource="{x:Bind Exif}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ExifRow">
                                <Grid ColumnDefinitions="104,*" Margin="0,3,0,3">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
