<Window
    x:Class="Rawie.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rawie.App"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12">
            <Button Content="Open folder…" Click="OnPickFolder" />
            <TextBlock x:Name="PathText" Text="(no folder)" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <GridView x:Name="Grid" Grid.Row="1"
                  Padding="8"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  ContainerContentChanging="OnContainerContentChanging"
                  KeyDown="OnGridKeyDown">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:PhotoItem">
                    <Grid Width="184" Height="184" Margin="4" RowDefinitions="*,Auto"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="4">
                        <Image Grid.Row="0" Source="{x:Bind Thumb, Mode=OneWay}" Stretch="Uniform" Margin="4" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                   Padding="4,2" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="StatusText" Grid.Row="2" Padding="12,6" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
