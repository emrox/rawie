<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI installer for RAWimp.

  Built from the self-contained publish output, so the installed app needs no runtimes and the
  installer needs no code-signing certificate to work (unlike MSIX, which Windows refuses to install
  unsigned).

  Per-user install: no administrator rights, lands in %LOCALAPPDATA%\Programs\RAWimp.

    wix build installer/RAWimp.wxs -arch x64 -ext WixToolset.UI.wixext
        -d PublishDir=<published folder> -d AssetsDir=<repo>\assets
        -o RAWimp-setup-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Release builds pass -d Version=x.y.z; local builds get this placeholder. Without a real
       version each release would claim to be the same one, and upgrades would stop working. -->
  <?ifndef Version?>
  <?define Version = "0.0.1"?>
  <?endif?>

  <?ifndef LicenseRtf?>
  <?define LicenseRtf = "gpl-3.0.rtf"?>
  <?endif?>

  <Package Name="RAWimp"
           Manufacturer="RAWimp"
           Version="$(Version)"
           UpgradeCode="6f2b1c94-5d3a-4f2e-9a41-7c1e8b0d2a55"
           Scope="perUser"
           Compressed="yes">

    <!-- Everything in one .msi file — without EmbedCab the payload is written beside it as a
         separate cab, which is no use as a download. -->
    <Media Id="1" Cabinet="rawimp.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- Installing a newer version replaces the old one rather than stacking copies. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of RAWimp is already installed." />

    <Icon Id="RAWimpIcon" SourceFile="$(AssetsDir)\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="RAWimpIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RAWimp" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="RAWimp" />
    </StandardDirectory>

    <Feature Id="Main" Title="RAWimp" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Harvests the whole publish folder; no need to list 400+ runtime files by hand. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="7b3c4d51-8e2f-4a6b-9d10-3f5a2c7e91b4">
      <Shortcut Id="RAWimpShortcut"
                Name="RAWimp"
                Target="[INSTALLFOLDER]RAWimp.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="RAWimpIcon" />
      <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\RAWimp" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The InstallDir flow shows a licence page; without this it displays WiX's placeholder text.
         Generated from the verbatim LICENSE at the repo root. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
